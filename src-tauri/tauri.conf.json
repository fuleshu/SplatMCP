{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SplatMCP",
  "version": "0.1.0",
  "identifier": "com.splatmcp.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SplatMCP",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost blob: data:",
        "img-src": "'self' blob: data:",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob: data:"
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
